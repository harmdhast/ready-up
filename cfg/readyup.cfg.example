# Ready Up runtime config.
#
# Lives next to the shim: game/csgo/readyup/bin/linuxsteamrt64/readyup.cfg
# The release installer creates it from this example only if it is missing, so your
# edits survive upgrades. Apply changes in-game with: .ru reload
#
# Booleans: 0/1 (or n/y, f/t).
debug=0
chat_debug=0
banner=1
# Per-player "Ready Up is live" center screen on first T/CT join each map.
welcome=1
# welcome_show_seconds=8        how long the welcome card stays up (then the ready HUD)
# welcome_round_delay_ms=5000   the welcome card waits this long after a round (re)start (CS2's "Match started" covers the panel)
# Go-live card: "LIVE · GO GO GO", the teams and the commands, in the center for everyone this many
# seconds once a map goes live (starts welcome_round_delay_ms after the go-live restart). 0 = off.
# golive_card_seconds=10
# `.admin [message]`: seconds before the same player can call an admin again (0 = no cooldown).
# admin_call_cooldown_s=60

# DEBUG ONLY: bots on CT/T count as always-ready scrim players, so one human can
# test ready -> live with bots. Never enable on a real match server.
# (env override: READYUP_DEV_BOTS_READY)
dev_bots_ready=0

# DEBUG ONLY: a scrim starts and runs with only bots on CT and T (no humans): scrim warmup,
# countdown, knife, live. For scripts/livetest --scrim. Never enable on a real server.
# (env override: READYUP_DEV_BOTS_SCRIM; console: ru_dev_bots_scrim 0|1|cfg)
dev_bots_scrim=0

# Prefixes (supports ChatColors tokens like <DarkRed>, <Default>, <LightBlue>, <Orange>, ...).
# Ready Up always adds a single space after the prefix in output.
chat_prefix=<DarkRed>[Ready Up]<Default>
admin_prefix=<DarkRed>[Admin]<Default>

# Local status endpoint (docs/FLEET.md §17): read-only HTTP for csm / uptime checks / curl.
# GET /health /status /stream (SSE) /metrics /selftest. Loopback clients need no token; others
# send `Authorization: Bearer <token>`. Port + token are written to csgo/readyup/status.json.
# status_http_enabled=1
# status_http_bind=127.0.0.1
# status_http_port=0          (0 = game port + 7, e.g. 27022 for 27015)
# status_http_token=          (empty = generated once and kept in status.json)
# status_http_metrics=0

# Server frame time (`ru perf` / `.ru plugin perf`: time each plugin takes per frame). A frame whose
# plugin callbacks took longer than perf_warn_ms, or that came perf_gap_warn_ms after the previous
# frame (the engine itself, a map load, hibernation), is logged with its top callbacks, at most
# once every 10 s.
# perf_warn_ms=8
# perf_gap_warn_ms=250

# Match rules (readyup-match). Scrims use these; a match config's own values win for matches.
# max_tech_pauses_per_team=3     technical pauses (.tech/.pause) per team per map, 0 = unlimited
# tech_pause_max_seconds=300     auto-unpause after this long, 0 = never
# disconnect_pause_max_seconds=300  a pause for a short side (sv_matchpause_auto_5v5) goes on by itself
#                                when both sides are full again, or after this long; 0 = never
# both_teams_unpause_required=1  0 = the pausing team alone can unpause
# allow_force_ready=1            .forceready readies the caller's team
# team_ready=0                   1: a rostered player's .ready / .unready is for their whole team (match warmup)
# min_players_to_ready=0         players a team needs ready to go live / connected to force ready
#                                (0 = a full team: players_per_team, else 5; substitutes on top).
#                                The same value as minimum_ready_required below.
# forfeit_after_seconds=240      a team with nobody connected on a live map forfeits, 0 = off
# Tactical timeouts (.tac) are CS2's: mp_team_timeout_max / mp_team_timeout_time (ReadyUp/live.cfg).

# Match server settings (docs/INSTALL.md "Match server settings"). A console / RCON / chat / fleet
# change (ru_<name> <value>, .ru settings set) is saved in state.json and wins over these.
# minimum_ready_required=0             players a team needs ready to go live (0 = a full team)
# playout_enabled_default=0            play every round, no clinch
# autoready_enabled=0                  roster players are ready when they join their team
# knife_enabled_default=1              knife round for scrims and maps without a side (old key: scrim_knife)
# reset_cvars_on_series_end=1          reset the warmup cvars and the match cvars{} when a series ends
# use_pause_command_for_tactical_pause=0   .pause / .p call a tactical timeout
# hostname_format=                     e.g. "{TEAM1} vs {TEAM2}" while a match is loaded (empty = off)
# kick_when_no_match_loaded=0          kick non-admins while no match is loaded
# whitelist_enabled_default=1          only roster / spectators / admins may join a match

# Scrim / match warmup: money topped up to $16000 after every purchase, like CS2's own warmup.
# warmup_money=1

# Idle / scrim / match warmup: weapons with no owner for 2 seconds are removed (G-drops; nothing
# drops on death in warmup anyway), the C4 too (no bomb in warmup). 0 = leave them to CS2's
# weapon_auto_cleanup_time.
# warmup_weapon_cleanup=1

# Idle map refresh: after this many hours on one map with no match loaded and nobody connected,
# load the same map again (0 = off). Long uptime on one map makes player animations run in slow
# motion; a map load fixes it. Loading a match always changes map, also onto the current one.
# idle_map_refresh_hours=12

# File retention, checked at plugin load and every map start: round backups / resume files
# (readyup_backup_* / readyup_resume_*) and GOTV demos (*.dem in ru_demo_path) last written more
# than this many hours ago are deleted. The loaded match's files and the demo being recorded are
# always kept. 0 = keep forever. (fleet.so's [fleet] demo_keep_hours is its own, for streamed demos.)
# backup_keep_hours=72
# demo_keep_hours=24

# Ruleset for loaded matches (docs/ESPORTS-MODE.md): default (ReadyUp/live.cfg, MatchZy-style) |
# valve (Valve's CS Major rules: ReadyUp/esports_live.cfg, no knife rounds, skins plugin inert).
# A match config's "ruleset" (and its "overrides") wins. Scrims use this one.
ruleset=default
# Models the default_models override resets players to (off unless a match config turns it on):
# default_model_ct=agents/models/ctm_sas/ctm_sas.vmdl
# default_model_t=agents/models/tm_phoenix/tm_phoenix.vmdl

# Plugin settings. Everything after the first [section] line belongs to a plugin and is read
# with ru_api config_get (the plugin's own csgo/cfg/ReadyUp/<plugin>.cfg wins over this).
# Core keys must stay above the first section.
# [hello]
# greeting=hi there
